const true = 1
const false = 0

{:if <condition true -- > (if-else {})}
{:do-while <body condition -- > swap dup i while}

{:not <n -- !n> (if-else {false} {true})}

{:puts <s -- >
  (while {(get dup)} {
    (putc (get dup))
    inc
  })
  drop
}

{:putl <s -- > puts (putc 10)}

{:dec <n -- n-1> (sub 1)}
{:inc <n -- n-1> (add 1)}

{:mul <a b -- a*b>
  (swap 0)

  (while {dup} {
    rot
    rot
    swap
    dup
    rot
    add
    rot
    dec
  })
  
  drop
  swap
  drop
}

