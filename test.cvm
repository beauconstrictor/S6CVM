import std

const COUNT = 25 <because countdown is 2 bytes, the numbers will wrap after the 25th fib, so we stop there>

var countdown[2]

{:fib-next <a b -- b c>
  over
  over
  add
  rot
  drop
}

{:fib-from <a b -- >
  (while {(gt (get countdown) 0)} {
    (puti (dup fib-next))
    (set countdown (dec (get countdown)))
  })
  drop drop
}

{:main
  (puts "25 Fibonacci numbers:")
  (puti 0)
  (puti 1)
  (set countdown (sub COUNT 2))
  (fib-from 0 1)
}

import std

{:main
  (puti (mul 5 6))
}
