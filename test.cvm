import std

const COUNT = 25

var countdown[2]

{:fib-next <a b -- b c>
  over
  over
  add
  rot
  drop
}

{:fib-from <a b -- >
  (while {(gt (get countdown) 0)} {
    (puti (dup fib-next))
    (set countdown (dec (get countdown)))
  })
  drop drop
}

{:main
  "25 Fibonacci numbers:" &putc i
}

{:test
  (puti 0)
  (puti 1)
  (set countdown (sub COUNT 2))
  (fib-from 0 1)
}
