import std

const COUNT = 23

var countdown[int]

{:fib-from <a b -- >
  (while {(gt (get countdown) 0)} {
    (puti over
          over
          add
          rot
          drop
          dup)

    (set countdown (dec (get countdown)))
  })
}

{:main
  (set countdown COUNT)
  (puti 0)
  (puti 1)
  (fib-from 0 1)
}
